[TEMPLATE]
# Environment
ENVIRONMENT=development

# Server Configuration
SERVER_ADDRESS=:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_MAX_HEADER_BYTES=1048576

# Secrets (change these in production!)
QR_SECRET_KEY=dev-qr-secret-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DATABASE=rwanda_drive

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://docproof1.vercel.app

# Blockchain / Chain Integration
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
LICENSE_REGISTRY_ADDR=0x0000000000000000000000000000000000000000
CREDENTIAL_REGISTRY_ADDR=0x0000000000000000000000000000000000000000
AUDIT_ANCHOR_ADDR=0x0000000000000000000000000000000000000000
BLOCK_CONFIRMATIONS=1
CHAIN_POLL_INTERVAL=2s

# KMS Signer Configuration
# Options: "local" (dev), "aws" (production), "gcp" (production)
KMS_PROVIDER=local
# For local: set to the hex private key (dev only!)
KMS_LOCAL_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For AWS KMS:
KMS_KEY_ID=
KMS_REGION=

# Logging
LOG_LEVEL=info
